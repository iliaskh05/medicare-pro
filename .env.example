# MediCare Pro — variables d'environnement
# Copier vers .env.local (dev poste) ou renseigner au boot production.
# Ne jamais committer de vrais secrets.

# --- Frontend (baké au `npm run build` ; surchargeable par poste via Configuration serveur) ---
# Dev : localhost. Centre : IP/hostname du SERVEUR, pas du PC client.
# Exemple : VITE_JAVA_API_URL=http://SERVER_IP:8080
VITE_JAVA_API_URL=http://localhost:8080
VITE_ML_API_URL=http://127.0.0.1:8090
# Optionnel. Sinon le WS utilise le même hôte que l'API Java (/ws/chat).
# VITE_WS_URL=ws://SERVER_IP:8080
VITE_API_TIMEOUT_MS=15000

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# 0.0.0.0 = joignable depuis le LAN. Ne pas laisser 127.0.0.1 en centre.
SERVER_ADDRESS=0.0.0.0
DB_URL=jdbc:postgresql://localhost:5433/medicare_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
RADIOCRM_JWT_SECRET=change-me-in-production-use-base64-256bit
# Origines UI explicites (en plus des IP privées RFC1918 si RADIOCRM_CORS_ALLOW_PRIVATE_LAN=true)
RADIOCRM_CORS_ORIGINS=http://localhost:8081,http://localhost:5173
RADIOCRM_CORS_ALLOW_PRIVATE_LAN=true
RADIOCRM_PUBLIC_REGISTER=false
RADIOCRM_FRONTEND_BASE_URL=http://localhost:8081

# Identité du centre (factures)
RADIOCRM_CENTRE_NOM=Centre d'Imagerie Bentachfine
RADIOCRM_CENTRE_VILLE=Témara
RADIOCRM_CENTRE_ADRESSE=
RADIOCRM_CENTRE_TELEPHONE=
RADIOCRM_CENTRE_EMAIL=
RADIOCRM_CENTRE_ICE=
RADIOCRM_CENTRE_IF=
RADIOCRM_CENTRE_TAXE_PRO=

# Mail (reset mot de passe)
MAIL_USERNAME=
MAIL_PASSWORD=

# Gemini assistant — serveur uniquement
GEMINI_API_KEY=
GEMINI_ENABLED=false

# ML anomalies
ML_ENABLED=false
ML_SERVICE_URL=http://127.0.0.1:8090
ML_SERVICE_API_KEY=

# WhatsApp Cloud API — non implémenté côté Java (écran UI = NOT CONFIGURED)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
