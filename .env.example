# RadioCRM API
RADIOCRM_API_KEY=dev-radiocrm-key
RADIOCRM_JWT_SECRET=change-me-in-production
VITE_RADIOCRM_API_KEY=dev-radiocrm-key

# LLM serveur (POST /api/reports/structure) — ne pas exposer côté client
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Assistant plateforme (Gemini) — serveur Spring uniquement
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=true

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=radiocrm-wa-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Companion services
ML_SERVICE_URL=http://127.0.0.1:8090
WS_PUBLIC_URL=ws://127.0.0.1:8788/chat
WS_PORT=8788
API_BASE=http://127.0.0.1:8080

# Backend Spring Boot (frontend Vite) — défaut http://localhost:8080 si absent
# LAN : VITE_JAVA_API_URL=http://192.168.x.x:8080 (jamais hardcodé dans le build)
# Alias historique : API_BASE / API_BASE_URL → utiliser VITE_JAVA_API_URL
VITE_JAVA_API_URL=http://localhost:8080
VITE_ML_API_URL=http://127.0.0.1:8090
API_BASE_URL=http://localhost:8080

# PostgreSQL / Spring
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5433/medicare_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
RADIOCRM_JWT_SECRET=dGhpc0lzQVJhZGlvQ1JNUmlzU2VjdXJlS2V5Rm9ySFMyNTZBbmdvMjU2Yml0cw==
RADIOCRM_CORS_ORIGINS=http://localhost:8081,http://localhost:5173
